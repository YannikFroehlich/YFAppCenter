<Window x:Class="YFAppCenter.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YF AppCenter Setup"
        Width="820" Height="540"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Background}" Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        SourceInitialized="OnSourceInitialized" Closing="OnClosing">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="1" ResizeBorderThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Linke Seite: Marke und Fortschritt durch die Schritte -->
        <Grid Background="{StaticResource Accent}">
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0.3" />
                        <GradientStop Color="#55000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- Dekorative Kacheln im Hintergrund, angelehnt an das Logo -->
            <Canvas ClipToBounds="True" IsHitTestVisible="False" Opacity="0.08">
                <Rectangle Canvas.Left="150" Canvas.Top="300" Width="150" Height="150" RadiusX="34" RadiusY="34" Fill="White" />
                <Ellipse Canvas.Left="180" Canvas.Top="120" Width="150" Height="150" Fill="White" />
                <Rectangle Canvas.Left="-40" Canvas.Top="420" Width="150" Height="150" RadiusX="34" RadiusY="34" Fill="White" />
            </Canvas>
            <DockPanel Margin="30,36,26,28">
                <StackPanel DockPanel.Dock="Top">
                    <Image Source="{StaticResource Logo}" Width="64" Height="64" HorizontalAlignment="Left">
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.35" />
                        </Image.Effect>
                    </Image>
                    <TextBlock Text="YF AppCenter" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,18,0,0" />
                    <TextBlock x:Name="VersionText" Foreground="#CCFFFFFF" Margin="0,2,0,0" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="Spiele &amp; Programme an einem Ort" Foreground="#B3FFFFFF" FontSize="12" />
                <StackPanel x:Name="StepsPanel" VerticalAlignment="Center" />
            </DockPanel>
        </Grid>

        <!-- Rechte Seite: Inhalt der Schritte -->
        <Grid Grid.Column="1" Margin="44,52,40,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Willkommen -->
            <StackPanel x:Name="WelcomePage">
                <TextBlock Style="{StaticResource PageTitle}" Text="Willkommen" />
                <TextBlock x:Name="WelcomeText" Style="{StaticResource Secondary}" Margin="0,0,0,24" />
                <ItemsControl x:Name="Features" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,16">
                                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource Surface}"
                                        BorderBrush="{StaticResource Stroke}" BorderThickness="1" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="18"
                                               HorizontalAlignment="Center" Foreground="#B9A6FF" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Text}" Style="{StaticResource Secondary}" FontSize="13" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border x:Name="ExistingCard" Style="{StaticResource Card}" Margin="0,4,0,0" Visibility="Collapsed">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" FontSize="18" Foreground="#B9A6FF"
                                   VerticalAlignment="Top" Margin="0,1,12,0" />
                        <TextBlock x:Name="ExistingText" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- Einstellungen -->
            <StackPanel x:Name="OptionsPage" Visibility="Collapsed">
                <TextBlock Style="{StaticResource PageTitle}" Text="Einstellungen" />
                <TextBlock Style="{StaticResource Secondary}" Margin="0,0,0,22"
                           Text="Wähle, wo YF AppCenter installiert wird und wie du es starten möchtest." />

                <TextBlock Style="{StaticResource SectionLabel}" Text="Installationsordner" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" MinWidth="0"
                            Padding="14,8" Click="OnBrowseClick" ToolTip="Ordner auswählen">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" Margin="0,0,8,0" />
                            <TextBlock Text="Durchsuchen …" />
                        </StackPanel>
                    </Button>
                    <TextBox x:Name="DirectoryBox" TextChanged="OnDirectoryChanged" />
                </DockPanel>
                <TextBlock x:Name="DirectoryError" Foreground="{StaticResource Danger}" TextWrapping="Wrap" FontSize="13"
                           Margin="0,8,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="SpaceText" Style="{StaticResource Secondary}" FontSize="13" Margin="0,8,0,0" />

                <TextBlock Style="{StaticResource SectionLabel}" Text="Verknüpfungen &amp; Start" Margin="0,22,0,8" />
                <Border Style="{StaticResource Card}" Padding="16,6">
                    <StackPanel>
                        <CheckBox x:Name="StartMenuBox" Margin="0,8">
                            <StackPanel>
                                <TextBlock Text="Verknüpfung im Startmenü" />
                                <TextBlock Text="Empfohlen – von dort lässt es sich auch an die Taskleiste anheften."
                                           Style="{StaticResource Secondary}" FontSize="12" />
                            </StackPanel>
                        </CheckBox>
                        <Border Height="1" Background="{StaticResource Stroke}" />
                        <CheckBox x:Name="DesktopBox" Margin="0,8">
                            <TextBlock Text="Verknüpfung auf dem Desktop" />
                        </CheckBox>
                        <Border Height="1" Background="{StaticResource Stroke}" />
                        <CheckBox x:Name="AutostartBox" Margin="0,8">
                            <StackPanel>
                                <TextBlock Text="Mit Windows starten" />
                                <TextBlock Text="Startet minimiert bei der Anmeldung und ist sofort griffbereit."
                                           Style="{StaticResource Secondary}" FontSize="12" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Fortschritt -->
            <StackPanel x:Name="ProgressPage" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,0,40">
                <TextBlock x:Name="ProgressTitle" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="ProgressStatus" Style="{StaticResource Secondary}" Margin="0,0,0,26" />
                <ProgressBar x:Name="ProgressBar" Maximum="100" />
                <TextBlock x:Name="ProgressPercent" Style="{StaticResource Secondary}" HorizontalAlignment="Right"
                           FontSize="13" Margin="0,8,0,0" />
            </StackPanel>

            <!-- Fertig / Fehler -->
            <StackPanel x:Name="DonePage" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,0,30">
                <Border x:Name="DoneBadge" Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Left"
                        Background="{StaticResource Accent}" Margin="0,0,0,22">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.4" Color="#7C3AED" />
                    </Border.Effect>
                    <TextBlock x:Name="DoneGlyph" Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="32"
                               Foreground="White" HorizontalAlignment="Center" />
                </Border>
                <TextBlock x:Name="DoneTitle" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="DoneText" Style="{StaticResource Secondary}" Margin="0,0,0,22" />
                <CheckBox x:Name="LaunchBox" Content="YF AppCenter jetzt starten" IsChecked="True" Margin="0,0,0,22" />
                <Border x:Name="PinTip" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE718;" FontSize="18" Foreground="#B9A6FF"
                                   VerticalAlignment="Top" Margin="0,1,12,0" />
                        <TextBlock TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Text="Tipp:" />
                            <Run Text="Rechtsklick auf das Symbol in der Taskleiste und „An Taskleiste anheften“ – dann ist alles einen Klick entfernt." />
                        </TextBlock>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- Deinstallation bestätigen -->
            <StackPanel x:Name="UninstallPage" Visibility="Collapsed">
                <TextBlock Style="{StaticResource PageTitle}" Text="Deinstallieren" />
                <TextBlock x:Name="UninstallText" Style="{StaticResource Secondary}" Margin="0,0,0,24" />
                <Border Style="{StaticResource Card}">
                    <CheckBox x:Name="DeleteDataBox">
                        <StackPanel>
                            <TextBlock Text="Auch meine Bibliothek löschen" />
                            <TextBlock Style="{StaticResource Secondary}" FontSize="12"
                                       Text="Favoriten, Kategorien, eigene Cover und hinzugefügte Programme. Ausgeschaltet bleiben sie für eine spätere Installation erhalten." />
                        </StackPanel>
                    </CheckBox>
                </Border>
            </StackPanel>

            <!-- Schaltflächen -->
            <DockPanel Grid.Row="1" LastChildFill="False">
                <Button x:Name="CancelButton" DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Content="Abbrechen"
                        Click="OnCancelClick" />
                <Button x:Name="NextButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" IsDefault="True"
                        Click="OnNextClick" Margin="10,0,0,0" />
                <Button x:Name="BackButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Zurück"
                        Click="OnBackClick" />
            </DockPanel>
        </Grid>

        <!-- Eigene Schließen-Schaltfläche (das Fenster hat keinen Systemrahmen) -->
        <Button Grid.Column="1" Style="{StaticResource CaptionButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCancelClick" ToolTip="Schließen">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8BB;" FontSize="10" />
        </Button>
    </Grid>
</Window>
