<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Nur für das Tray-Symbol (NotifyIcon); WPF hat keins. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>AppCenter.ico</ApplicationIcon>
    <!-- ThemeMode (Fluent-Design) ist in WPF noch als experimentell markiert. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <Product>YF AppCenter</Product>
    <!-- Basis für Releases: jeder Push auf main zählt die letzte Stelle des neuesten Tags hoch. Für einen größeren
         Sprung hier die neue Version eintragen (etwa 0.5.0); ist sie höher als der letzte Tag, wird sie genommen. -->
    <Version>0.4.0</Version>
    <StartupObject>YFAppCenter.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <!-- Spielerkennung kommt direkt aus YFTimeTracker (Git-Submodul), damit beide Programme dieselben Spiele finden. -->
    <ProjectReference Include="..\external\YFTimeTracker\YFTimeTracker.Windows\YFTimeTracker.Windows.csproj" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <Resource Include="AppCenter.ico" />
    <InternalsVisibleTo Include="YFAppCenter.Tests" />
    <!-- Sonst kollidieren WinForms-Typen (Button, MessageBox …) mit denen von WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>
