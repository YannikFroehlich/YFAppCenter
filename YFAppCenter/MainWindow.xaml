<Window x:Class="YFAppCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="YF AppCenter"
        Icon="AppCenter.ico"
        Width="1220" Height="800" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        AllowDrop="True" DragEnter="OnDragEnter" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop"
        Activated="OnActivated">
    <!-- Eigene Titelleiste: der Inhalt reicht bis an den oberen Rand. Links, rechts und unten bleibt der
         (unsichtbare) Windows-Rahmen, damit sich die Größe wie gewohnt ziehen lässt. GlassFrameThickness 0 würde
         eine Fensterregion setzen und damit runde Ecken und Schatten von Windows 11 abschalten. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="1" CornerRadius="0"
                      UseAeroCaptionButtons="False" NonClientFrameEdges="Left,Right,Bottom" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />

        <!-- Kachelmaße; MainWindow passt sie an die Fensterbreite an, damit die Kacheln die Zeile füllen. -->
        <sys:Double x:Key="TileWidth">216</sys:Double>
        <sys:Double x:Key="TileArtHeight">122</sys:Double>

        <!-- Logo als Vektor, damit es in jeder Größe scharf bleibt. -->
        <DrawingImage x:Key="Logo">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing>
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,256,256" RadiusX="58" RadiusY="58" />
                        </GeometryDrawing.Geometry>
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2563EB" Offset="0" />
                                <GradientStop Color="#7C3AED" Offset="0.55" />
                                <GradientStop Color="#DB2777" Offset="1" />
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,256,256" RadiusX="58" RadiusY="58" />
                        </GeometryDrawing.Geometry>
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#40FFFFFF" Offset="0" />
                                <GradientStop Color="#00FFFFFF" Offset="0.6" />
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#2D1E1B4B">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="52,57,66,66" RadiusX="17" RadiusY="17" />
                                <RectangleGeometry Rect="52,143,66,66" RadiusX="17" RadiusY="17" />
                                <RectangleGeometry Rect="138,143,66,66" RadiusX="17" RadiusY="17" />
                                <EllipseGeometry Center="171,90" RadiusX="33" RadiusY="33" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFFFFFFF">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="52,52,66,66" RadiusX="17" RadiusY="17" />
                                <EllipseGeometry Center="171,85" RadiusX="33" RadiusY="33" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#D7FFFFFF">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="52,138,66,66" RadiusX="17" RadiusY="17" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#AFFFFFFF">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="138,138,66,66" RadiusX="17" RadiusY="17" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M162,70 L162,100 L187,85 Z">
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6D28D9" Offset="0" />
                                <GradientStop Color="#DB2777" Offset="1" />
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                        <GeometryDrawing.Pen>
                            <Pen Thickness="6" LineJoin="Round">
                                <Pen.Brush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#6D28D9" Offset="0" />
                                        <GradientStop Color="#DB2777" Offset="1" />
                                    </LinearGradientBrush>
                                </Pen.Brush>
                            </Pen>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Hauptaktion: Markenverlauf, beim Überfahren mit einer weißen Schicht aufgehellt. -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bg" CornerRadius="10" Background="{StaticResource BrandBrush}" />
                            <Border x:Name="Shine" CornerRadius="10" Background="White" Opacity="0" />
                            <Border x:Name="Ring" CornerRadius="10" BorderThickness="1" BorderBrush="#33FFFFFF" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shine" Property="Opacity" Value="0.12" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shine" Property="Opacity" Value="0" />
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="White" />
                                <Setter TargetName="Ring" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nebenaktion: halbtransparente Fläche, passt auf jeden Hintergrund. -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10" Background="{StaticResource GlassBrush}"
                                BorderBrush="{StaticResource GlassStrokeBrush}" BorderThickness="1">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource GlassHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource GlassBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Halbtransparenter Rundknopf auf Bildern (Banner). -->
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="24" Background="#26FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="White" />
                                <Setter TargetName="Bg" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fensterknöpfe der eigenen Titelleiste; wie bei Windows nicht per Tab erreichbar. -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0BFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#B3C42B1C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
            <Setter Property="FontSize" Value="10" />
        </Style>

        <!-- Navigation links im Launcher-Stil: gewählter Bereich als Verlaufsfläche, der Rest gedämpft. -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="10" Background="Transparent" Padding="12,10" BorderThickness="1.5" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource GlassBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrandBrush}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>

        <!-- Erbt die Schriftfarbe, damit die Zahl auch auf der Verlaufsfläche lesbar bleibt. -->
        <Style x:Key="NavCount" TargetType="TextBlock">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>

        <Style x:Key="NavHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="13,22,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <!-- Rahmenloser Symbolknopf für die Leiste unten links. -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10" Background="Transparent" BorderThickness="1.5" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource GlassHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource GlassBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kachel ohne eigenen Kartenrahmen: das Bild ist die Karte, Titel stehen darunter (wie in Spiele-Launchern). -->
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Width" Value="{DynamicResource TileWidth}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,20,26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent">
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Leuchtende Tastenkappe in der Controller-Hilfe. -->
        <Style x:Key="PadKey" TargetType="Border">
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="TextElement.FontWeight" Value="Bold" />
            <Setter Property="TextElement.FontSize" Value="11" />
            <Setter Property="TextElement.Foreground" Value="#0E0F14" />
        </Style>

        <DataTemplate x:Key="CategoryNavContent">
            <DockPanel>
                <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE8B7;" />
                <TextBlock Text="{Binding Count}" Style="{StaticResource NavCount}" />
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </DataTemplate>

        <!-- Kachel hebt sich bei Hover oder Fokus leicht an; Play-Knopf gleitet herein. -->
        <Storyboard x:Key="TileRaise">
            <DoubleAnimation Storyboard.TargetName="ArtScale" Storyboard.TargetProperty="ScaleX" To="1.045" Duration="0:0:0.2" EasingFunction="{StaticResource EaseOut}" />
            <DoubleAnimation Storyboard.TargetName="ArtScale" Storyboard.TargetProperty="ScaleY" To="1.045" Duration="0:0:0.2" EasingFunction="{StaticResource EaseOut}" />
            <DoubleAnimation Storyboard.TargetName="PlayBadge" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
            <DoubleAnimation Storyboard.TargetName="PlayShift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2" EasingFunction="{StaticResource EaseOut}" />
        </Storyboard>
        <Storyboard x:Key="TileLower">
            <DoubleAnimation Storyboard.TargetName="ArtScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}" />
            <DoubleAnimation Storyboard.TargetName="ArtScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}" />
            <DoubleAnimation Storyboard.TargetName="PlayBadge" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
            <DoubleAnimation Storyboard.TargetName="PlayShift" Storyboard.TargetProperty="Y" To="6" Duration="0:0:0.2" />
        </Storyboard>

        <DataTemplate x:Key="TileTemplate">
            <Button x:Name="Tile" Style="{StaticResource TileButton}" Click="OnTileClick"
                    ContextMenuOpening="OnTileContextMenuOpening" ToolTip="{Binding DisplayName}"
                    AutomationProperties.Name="{Binding DisplayName}">
                <Button.ContextMenu>
                    <ContextMenu />
                </Button.ContextMenu>
                <StackPanel>
                    <!-- Bildfläche mit abgerundeten Ecken über Bildpinsel statt Clip; so passt sie sich jeder Kachelbreite an.
                         Bei Hover oder Fokus wächst sie leicht und bekommt Schatten, Play-Knopf und (bei Fokus) einen Ring. -->
                    <Grid x:Name="Art" Height="{DynamicResource TileArtHeight}" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="ArtScale" />
                        </Grid.RenderTransform>
                        <!-- Collapsed statt unsichtbar: so kostet der Schatten nur bei Hover/Fokus Rechenzeit. -->
                        <Border x:Name="Shadow" CornerRadius="12" Background="{StaticResource CanvasBrush}" Visibility="Collapsed">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="32" ShadowDepth="12" Direction="270" Opacity="0.75" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="FocusRing" Margin="-5" CornerRadius="16" BorderThickness="2" Visibility="Collapsed"
                                BorderBrush="{StaticResource AccentTextBrush}" />
                        <Border CornerRadius="12" Background="#171821" />
                        <!-- Icon-Farben als weicher Schein auf der Karte (ohne Grafikeffekt, siehe IconWash). -->
                        <Border CornerRadius="12">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding IconWash}" Stretch="Fill" Opacity="0.8" />
                            </Border.Background>
                        </Border>
                        <TextBlock x:Name="Glyph" Style="{StaticResource Glyph}" Text="&#xE71D;" FontSize="38"
                                   HorizontalAlignment="Center" Opacity="0.45" Visibility="Collapsed" />
                        <Image Source="{Binding Icon}" Width="60" Height="60" RenderOptions.BitmapScalingMode="HighQuality" />
                        <!-- Eigenes Cover oder Steam-Titelbild deckt Icon und Hintergrund komplett ab. -->
                        <Border CornerRadius="12">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding TileArt}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <!-- Lichtkante oben und feiner Rand, damit sich auch dunkle Bilder vom Hintergrund abheben. -->
                        <Border CornerRadius="12" BorderThickness="1">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#33FFFFFF" Offset="0" />
                                    <GradientStop Color="#12FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                        </Border>
                        <Border x:Name="RunningBadge" CornerRadius="10" Padding="8,3,9,3" Margin="8"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Background="#D90B0C10"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#4ADE80" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Läuft" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="PlayBadge" Width="40" Height="40" CornerRadius="20" Margin="10"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0"
                                Background="{StaticResource BrandBrush}" BorderBrush="#40FFFFFF" BorderThickness="1">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="PlayShift" Y="6" />
                            </Border.RenderTransform>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="14" Margin="2,0,0,0"
                                       HorizontalAlignment="Center" Foreground="White" />
                        </Border>
                        <Border x:Name="Star" Width="26" Height="26" CornerRadius="13" Margin="8"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Background="#D90B0C10"
                                Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE735;" FontSize="12" Foreground="#FFC83D"
                                       HorizontalAlignment="Center" />
                        </Border>
                    </Grid>
                    <TextBlock x:Name="Name" Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Margin="2,12,2,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Margin="2,2,2,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <!-- Nur Zustände mit Hover oder Fokus animieren; ein Trigger für den Ruhezustand würde beim Aufbau
                     jeder Kachel Animationen starten. Fokusring nur bei Tastatur oder Controller. -->
                <Trigger SourceName="Tile" Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Shadow" Property="Visibility" Value="Visible" />
                    <Trigger.EnterActions>
                        <BeginStoryboard Storyboard="{StaticResource TileRaise}" />
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard Storyboard="{StaticResource TileLower}" />
                    </Trigger.ExitActions>
                </Trigger>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Shadow" Property="Visibility" Value="Visible" />
                    <Trigger.EnterActions>
                        <BeginStoryboard Storyboard="{StaticResource TileRaise}" />
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard Storyboard="{StaticResource TileLower}" />
                    </Trigger.ExitActions>
                </Trigger>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                    <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsGame}" Value="True">
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE7FC;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Favorite}" Value="True">
                    <Setter TargetName="Star" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter TargetName="RunningBadge" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Hidden}" Value="True">
                    <Setter TargetName="Tile" Property="Opacity" Value="0.4" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Seitenleiste -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,0,14,14">
                <!-- Liegt in der Titelleiste; daneben lässt sich das Fenster ziehen. -->
                <StackPanel x:Name="LogoPanel" DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,16,0,24"
                            HorizontalAlignment="Left" Background="Transparent" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Image Source="{StaticResource Logo}" Width="32" Height="32" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="YF AppCenter" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Spiele &amp; Programme" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <!-- Erscheint, sobald eine neue Version heruntergeladen ist. -->
                    <Border x:Name="UpdatePanel" Margin="0,0,0,14" Padding="14,12" CornerRadius="12" Visibility="Collapsed"
                            Background="#1F7C3AED" BorderBrush="#598B5CF6" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" Margin="0,0,8,0"
                                           Foreground="{StaticResource AccentTextBrush}" />
                                <TextBlock x:Name="UpdateText" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="Wird sonst beim Schließen installiert." FontSize="12" Margin="0,4,0,10" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Jetzt neu starten" Padding="12,7"
                                    Click="OnUpdateRestartClick" />
                        </StackPanel>
                    </Border>
                    <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="2,0,2,12" />
                    <DockPanel Margin="10,0,0,0">
                        <!-- Einstellungen als Menü, damit die Seitenleiste ruhig bleibt. -->
                        <Button x:Name="SettingsButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="OnSettingsClick" Margin="2,0,0,0"
                                ToolTip="Einstellungen" AutomationProperties.Name="Einstellungen">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" FontSize="14" />
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="ShowHiddenBox" Header="Ausgeblendete anzeigen" IsCheckable="True"
                                              Checked="OnShowHiddenChanged" Unchecked="OnShowHiddenChanged" />
                                    <MenuItem x:Name="AutostartBox" Header="Mit Windows starten" IsCheckable="True"
                                              Checked="OnAutostartChanged" Unchecked="OnAutostartChanged"
                                              ToolTip="Startet bei der Windows-Anmeldung im Infobereich" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="RescanButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="OnRescanClick"
                                ToolTip="Installierte Spiele neu suchen" AutomationProperties.Name="Spiele neu suchen">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="14" />
                        </Button>
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,8,0" />
                    </DockPanel>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <RadioButton x:Name="HomeNav" Style="{StaticResource NavItem}" GroupName="Nav" Tag="all" IsChecked="True" Checked="OnNavChecked">
                            <DockPanel>
                                <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE80F;" />
                                <TextBlock x:Name="CountAll" Style="{StaticResource NavCount}" />
                                <TextBlock Text="Startseite" />
                            </DockPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="favorites" Checked="OnNavChecked">
                            <DockPanel>
                                <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE734;" />
                                <TextBlock x:Name="CountFavorites" Style="{StaticResource NavCount}" />
                                <TextBlock Text="Favoriten" />
                            </DockPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="recent" Checked="OnNavChecked">
                            <DockPanel>
                                <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE81C;" />
                                <TextBlock x:Name="CountRecent" Style="{StaticResource NavCount}" />
                                <TextBlock Text="Zuletzt gestartet" />
                            </DockPanel>
                        </RadioButton>
                        <TextBlock Text="BIBLIOTHEK" Style="{StaticResource NavHeader}" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="games" Checked="OnNavChecked">
                            <DockPanel>
                                <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE7FC;" />
                                <TextBlock x:Name="CountGames" Style="{StaticResource NavCount}" />
                                <TextBlock Text="Spiele" />
                            </DockPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="apps" Checked="OnNavChecked">
                            <DockPanel>
                                <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE71D;" />
                                <TextBlock x:Name="CountApps" Style="{StaticResource NavCount}" />
                                <TextBlock Text="Programme" />
                            </DockPanel>
                        </RadioButton>

                        <!-- Eigene Kategorien; entstehen über das Kontextmenü einer Kachel. -->
                        <TextBlock x:Name="CategoryHeader" Text="KATEGORIEN" Style="{StaticResource NavHeader}" Visibility="Collapsed" />
                        <StackPanel x:Name="CategoryNav" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Inhalt -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Farbschein oben: Markenfarben auf jeder Seite, auf der Startseite zusätzlich die Farben des Banners.
                 Das Bannerbild ist winzig dekodiert und groß gezogen, das wirkt wie ein starker Weichzeichner ohne
                 Grafikeffekt (siehe UpdateHero). Ein Verlauf zur Hintergrundfarbe blendet alles aus. -->
            <Grid Grid.RowSpan="2" Height="620" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
                <Rectangle Fill="{StaticResource BrandGlowBrush}" />
                <Image x:Name="Ambient" Stretch="Fill" Margin="-80" Opacity="0.45" RenderOptions.BitmapScalingMode="Linear"
                       Visibility="{Binding Visibility, ElementName=Hero}" />
                <Rectangle Fill="{StaticResource CanvasFadeBrush}" />
            </Grid>

            <!-- Titelleiste: Suche, Hinzufügen und die Fensterknöpfe. Die Suche wird bis 400 px breit und
                 schrumpft in schmalen Fenstern mit; die freie Spalte daneben bleibt zum Ziehen des Fensters. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10*" MaxWidth="440" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource CaptionButton}" Click="OnMinimizeClick" ToolTip="Minimieren"
                            AutomationProperties.Name="Minimieren">
                        <TextBlock Style="{StaticResource CaptionGlyph}" Text="&#xE921;" />
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="OnMaximizeClick" ToolTip="Maximieren"
                            AutomationProperties.Name="Maximieren">
                        <TextBlock x:Name="MaximizeGlyph" Style="{StaticResource CaptionGlyph}" Text="&#xE922;" />
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Click="OnCloseClick" ToolTip="Schließen"
                            AutomationProperties.Name="Schließen">
                        <TextBlock Style="{StaticResource CaptionGlyph}" Text="&#xE8BB;" />
                    </Button>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Click="OnAddClick"
                        Margin="12,0,14,0" Padding="12,6" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="Programm oder Verknüpfung hinzufügen – Dateien lassen sich auch ins Fenster ziehen">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="Hinzufügen" />
                    </StackPanel>
                </Button>
                <Grid Margin="40,0,0,0" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown"
                             Padding="38,8,10,8" VerticalContentAlignment="Center">
                        <!-- Glasfläche statt der grauen Fluent-Box; Fokus zeigt den Markenrand. -->
                        <TextBox.Resources>
                            <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
                            <SolidColorBrush x:Key="TextControlBackground" Color="#0DFFFFFF" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#14FFFFFF" />
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#E60B0C10" />
                            <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="#1AFFFFFF" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#26FFFFFF" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#8B5CF6" />
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
                        </TextBox.Resources>
                    </TextBox>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" Margin="14,0,0,0" FontSize="14"
                               IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Suchen – Enter startet" IsHitTestVisible="False" Margin="39,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>

            <!-- Abstand als Margin statt Padding: der ScrollViewer schneidet am Padding-Rand ab, das kappte
                 die Kachelschatten der äußeren Spalten. -->
            <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ContentHost" Margin="40,14,40,24">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="ContentShift" />
                    </StackPanel.RenderTransform>
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock x:Name="PageTitle" FontFamily="{StaticResource DisplayFont}" FontSize="34" FontWeight="Bold" />
                        <TextBlock x:Name="PageSubtitle" Margin="0,4,0,0" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Banner der Startseite: zuletzt gestartet, sonst Favorit, sonst ein Spiel des Tages. -->
                    <Grid x:Name="Hero" Height="360" Margin="0,0,0,40" Visibility="Collapsed" SizeChanged="OnHeroSizeChanged">
                        <Grid.Clip>
                            <RectangleGeometry x:Name="HeroClip" RadiusX="18" RadiusY="18" />
                        </Grid.Clip>
                        <Rectangle Fill="#15161D" />
                        <!-- Ohne eigenes Bild: großes Symbol im Lichthof seiner Farbe. -->
                        <Grid Width="640" HorizontalAlignment="Right" Margin="0,-80,-20,-80">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source, ElementName=HeroImage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Image Source="{Binding IconWash}" Stretch="Fill" Opacity="0.7" RenderOptions.BitmapScalingMode="Linear" />
                            <Image Source="{Binding Icon}" Width="112" Height="112" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                        <Image x:Name="HeroImage" Stretch="UniformToFill" VerticalAlignment="Center" />
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#F00B0C10" Offset="0" />
                                    <GradientStop Color="#990B0C10" Offset="0.38" />
                                    <GradientStop Color="#000B0C10" Offset="0.75" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#000B0C10" Offset="0.45" />
                                    <GradientStop Color="#B30B0C10" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <!-- Lichtkante, damit sich das Banner auch vom Farbschein dahinter abhebt. -->
                        <Border CornerRadius="18" BorderThickness="1">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#40FFFFFF" Offset="0" />
                                    <GradientStop Color="#14FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                        </Border>
                        <StackPanel VerticalAlignment="Bottom" Margin="44,0,44,40" TextElement.Foreground="White">
                            <Border HorizontalAlignment="Left" CornerRadius="12" Padding="12,5" Margin="0,0,0,16"
                                    Background="#26FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
                                <TextBlock x:Name="HeroLabel" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <!-- Ohne Schatteneffekte: der dunkle Verlauf links hält Schrift und Logo lesbar. -->
                            <Image x:Name="HeroLogo" MaxHeight="110" MaxWidth="380" HorizontalAlignment="Left" Stretch="Uniform" />
                            <TextBlock x:Name="HeroTitle" Text="{Binding DisplayName}" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="44" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="620" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="14" Opacity="0.7" Margin="0,8,0,22" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}" Padding="30,0" Height="48" FontSize="15" Click="OnHeroPlayClick">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" Margin="0,0,10,0" />
                                        <TextBlock x:Name="HeroPlayText" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="HeroFavoriteButton" Style="{StaticResource GlassButton}" Margin="12,0,0,0"
                                        Click="OnHeroFavoriteClick">
                                    <TextBlock x:Name="HeroFavoriteGlyph" Style="{StaticResource Glyph}" FontSize="16" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Die Kachelbreite hängt an der Breite dieser Liste (siehe OnSectionsSizeChanged). -->
                    <ItemsControl x:Name="Sections" Focusable="False" SizeChanged="OnSectionsSizeChanged">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,18">
                                    <StackPanel x:Name="Header" Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="20"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Border CornerRadius="9" Padding="8,1,8,2" Margin="10,2,0,0" VerticalAlignment="Center"
                                                Background="{StaticResource GlassBrush}">
                                            <TextBlock Text="{Binding Items.Count}" FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <!-- Negativer Rand schluckt den Abstand rechts der letzten Kachel einer Zeile. -->
                                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TileTemplate}" Focusable="False"
                                                  Margin="0,0,-20,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Title}" Value="">
                                        <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="0,0,0,60" Visibility="Collapsed">
                <Grid Width="112" Height="112" HorizontalAlignment="Center">
                    <Ellipse Fill="#1A8B5CF6" />
                    <Ellipse Margin="18" Fill="{StaticResource BrandBrush}" />
                    <TextBlock x:Name="EmptyGlyph" Style="{StaticResource Glyph}" FontSize="30" HorizontalAlignment="Center"
                               Foreground="White" />
                </Grid>
                <TextBlock x:Name="EmptyTitle" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,24,0,6" />
                <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="400"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <!-- Nur bei einer wirklich leeren Bibliothek: direkt loslegen. -->
                <StackPanel x:Name="EmptyActions" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Click="OnAddClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" Margin="0,0,8,0" />
                            <TextBlock Text="Programm hinzufügen" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Padding="18,9" Margin="10,0,0,0" Click="OnRescanClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" Margin="0,0,8,0" />
                            <TextBlock Text="Spiele suchen" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Tastenhilfe, sobald ein Controller angeschlossen ist. -->
            <Border x:Name="PadHints" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"
                    CornerRadius="22" Padding="16,10" Background="#F2141620" BorderBrush="#1FFFFFFF" BorderThickness="1"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" TextElement.Foreground="White" TextElement.FontSize="12">
                    <Border Style="{StaticResource PadKey}" Background="#4ADE80"><TextBlock Text="A" VerticalAlignment="Center" /></Border>
                    <TextBlock Text="Starten" Margin="0,0,18,0" VerticalAlignment="Center" />
                    <Border Style="{StaticResource PadKey}" Background="#F87171"><TextBlock Text="B" VerticalAlignment="Center" /></Border>
                    <TextBlock Text="Zurück" Margin="0,0,18,0" VerticalAlignment="Center" />
                    <Border Style="{StaticResource PadKey}" Background="#60A5FA"><TextBlock Text="X" VerticalAlignment="Center" /></Border>
                    <TextBlock Text="Menü" Margin="0,0,18,0" VerticalAlignment="Center" />
                    <Border Style="{StaticResource PadKey}" Background="#FACC15"><TextBlock Text="Y" VerticalAlignment="Center" /></Border>
                    <TextBlock Text="Favorit" Margin="0,0,18,0" VerticalAlignment="Center" />
                    <Border Style="{StaticResource PadKey}" Background="#E5E7EB"><TextBlock Text="LB / RB" VerticalAlignment="Center" /></Border>
                    <TextBlock Text="Bereich wechseln" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Grid x:Name="DropOverlay" Grid.RowSpan="2" IsHitTestVisible="False" Visibility="Collapsed" Background="#F20E0F14">
                <Rectangle Margin="24" RadiusX="16" RadiusY="16" StrokeThickness="2" StrokeDashArray="6 4"
                           Stroke="{StaticResource AccentTextBrush}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="88" Height="88" HorizontalAlignment="Center">
                        <Ellipse Fill="#1A8B5CF6" />
                        <Ellipse Margin="14" Fill="{StaticResource BrandBrush}" />
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="26" HorizontalAlignment="Center" Foreground="White" />
                    </Grid>
                    <TextBlock Text="Zum Hinzufügen loslassen" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"
                               Margin="0,18,0,4" HorizontalAlignment="Center" />
                    <TextBlock Text="Programme, Verknüpfungen und Internetverknüpfungen" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
