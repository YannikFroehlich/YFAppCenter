<Window x:Class="YFAppCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YF AppCenter"
        Icon="AppCenter.ico"
        Width="1220" Height="800" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragEnter="OnDragEnter" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop"
        Activated="OnActivated">
    <Window.Resources>
        <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />

        <!-- Logo als Vektor, damit es in jeder Größe scharf bleibt. -->
        <DrawingImage x:Key="Logo">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing>
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,256,256" RadiusX="58" RadiusY="58" />
                        </GeometryDrawing.Geometry>
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2563EB" Offset="0" />
                                <GradientStop Color="#7C3AED" Offset="0.55" />
                                <GradientStop Color="#DB2777" Offset="1" />
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,256,256" RadiusX="58" RadiusY="58" />
                        </GeometryDrawing.Geometry>
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#40FFFFFF" Offset="0" />
                                <GradientStop Color="#00FFFFFF" Offset="0.6" />
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#2D1E1B4B">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="52,57,66,66" RadiusX="17" RadiusY="17" />
                                <RectangleGeometry Rect="52,143,66,66" RadiusX="17" RadiusY="17" />
                                <RectangleGeometry Rect="138,143,66,66" RadiusX="17" RadiusY="17" />
                                <EllipseGeometry Center="171,90" RadiusX="33" RadiusY="33" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFFFFFFF">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="52,52,66,66" RadiusX="17" RadiusY="17" />
                                <EllipseGeometry Center="171,85" RadiusX="33" RadiusY="33" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#D7FFFFFF">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="52,138,66,66" RadiusX="17" RadiusY="17" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#AFFFFFFF">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="138,138,66,66" RadiusX="17" RadiusY="17" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M162,70 L162,100 L187,85 Z">
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6D28D9" Offset="0" />
                                <GradientStop Color="#DB2777" Offset="1" />
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                        <GeometryDrawing.Pen>
                            <Pen Thickness="6" LineJoin="Round">
                                <Pen.Brush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#6D28D9" Offset="0" />
                                        <GradientStop Color="#DB2777" Offset="1" />
                                    </LinearGradientBrush>
                                </Pen.Brush>
                            </Pen>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Halbtransparenter Rundknopf auf Bildern (Banner). -->
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="22" Background="#33FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="White" />
                                <Setter TargetName="Bg" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navigation links, im Stil der Windows-11-NavigationView. -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Bg" CornerRadius="6" Background="Transparent" Padding="13,9" BorderThickness="1" BorderBrush="Transparent">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Pill" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>

        <Style x:Key="NavCount" TargetType="TextBlock">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <!-- Kachel ohne eigenen Kartenrahmen: das Bild ist die Karte, Titel stehen darunter (wie in Spiele-Launchern). -->
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Width" Value="216" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,18,22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="Lift" />
                            </Grid.RenderTransform>
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="-5" Duration="0:0:0.18" EasingFunction="{StaticResource EaseOut}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Kacheln blenden beim Erscheinen sanft ein. -->
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"
                                             FillBehavior="Stop" EasingFunction="{StaticResource EaseOut}" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="CategoryNavContent">
            <DockPanel>
                <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE8B7;" />
                <TextBlock Text="{Binding Count}" Style="{StaticResource NavCount}" />
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="TileTemplate">
            <Button x:Name="Tile" Style="{StaticResource TileButton}" Click="OnTileClick"
                    ContextMenuOpening="OnTileContextMenuOpening" ToolTip="{Binding DisplayName}"
                    AutomationProperties.Name="{Binding DisplayName}">
                <Button.ContextMenu>
                    <ContextMenu />
                </Button.ContextMenu>
                <StackPanel>
                    <Grid>
                        <!-- Schatten und Fokusring liegen hinter bzw. um das Bild und verschieben nichts. -->
                        <!-- Collapsed statt unsichtbar: so kostet der Schatten nur bei Hover/Fokus Rechenzeit. -->
                        <Border x:Name="Shadow" CornerRadius="12" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Visibility="Collapsed">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.55" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="FocusRing" Margin="-4" CornerRadius="15" BorderThickness="2.5" Visibility="Collapsed"
                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" />
                        <Grid Height="122">
                            <Grid.Clip>
                                <RectangleGeometry Rect="0,0,216,122" RadiusX="12" RadiusY="12" />
                            </Grid.Clip>
                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <!-- Icon-Farben als weicher Hintergrund der Karte (ohne Grafikeffekt, siehe IconWash). -->
                            <Image Source="{Binding IconWash}" Stretch="Fill" Margin="-30" Opacity="0.75"
                                   RenderOptions.BitmapScalingMode="Linear" />
                            <TextBlock x:Name="Glyph" Style="{StaticResource Glyph}" Text="&#xE71D;" FontSize="40"
                                       HorizontalAlignment="Center" Opacity="0.5" Visibility="Collapsed" />
                            <Image Source="{Binding Icon}" Width="68" Height="68" RenderOptions.BitmapScalingMode="HighQuality" />
                            <!-- Eigenes Cover oder Steam-Titelbild deckt Icon und Hintergrund komplett ab. -->
                            <Image Source="{Binding TileArt}" Stretch="UniformToFill" />
                            <!-- Feiner Innenrand, damit helle Bilder nicht mit dem Hintergrund verschwimmen. -->
                            <Border CornerRadius="12" BorderThickness="1" BorderBrush="#1FFFFFFF" />
                            <Border x:Name="RunningBadge" CornerRadius="10" Padding="8,3,9,3" Margin="8"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Background="#CC0B0B0F"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="#6CCB5F" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Läuft" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="PlayBadge" Width="38" Height="38" CornerRadius="19" Margin="10"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0"
                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="PlayShift" Y="6" />
                            </Border.RenderTransform>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="14" Margin="2,0,0,0"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                            <Border x:Name="Star" Width="26" Height="26" CornerRadius="13" Margin="8"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Background="#CC0B0B0F"
                                    Visibility="Collapsed">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE735;" FontSize="12" Foreground="#FFC83D"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Grid>
                    <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Margin="2,11,2,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Margin="2,2,2,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <!-- Play-Knopf und Fokusring bei Fokus durch Tastatur oder Controller zeigen. -->
                <Trigger SourceName="Tile" Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="PlayBadge" Property="Opacity" Value="1" />
                    <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Shadow" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Shadow" Property="Visibility" Value="Visible" />
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="PlayBadge" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                <DoubleAnimation Storyboard.TargetName="PlayShift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2" EasingFunction="{StaticResource EaseOut}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="PlayBadge" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                <DoubleAnimation Storyboard.TargetName="PlayShift" Storyboard.TargetProperty="Y" To="6" Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                    <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsGame}" Value="True">
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE7FC;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Favorite}" Value="True">
                    <Setter TargetName="Star" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter TargetName="RunningBadge" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Hidden}" Value="True">
                    <Setter TargetName="Tile" Property="Opacity" Value="0.4" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Seitenleiste -->
        <DockPanel Margin="12,8,12,12">
            <StackPanel x:Name="LogoPanel" DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,8,0,24">
                <Image Source="{StaticResource Logo}" Width="30" Height="30" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="YF AppCenter" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Spiele &amp; Programme" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="10,12,4,0">
                <!-- Erscheint, sobald eine neue Version heruntergeladen ist. -->
                <Border x:Name="UpdatePanel" Margin="-6,0,0,14" Padding="12,10" CornerRadius="8" Visibility="Collapsed"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" Margin="0,0,8,0"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="UpdateText" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="Wird sonst beim Schließen installiert." FontSize="12" Margin="0,4,0,8" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Button Style="{DynamicResource AccentButtonStyle}" Content="Jetzt neu starten" HorizontalAlignment="Stretch"
                                Click="OnUpdateRestartClick" />
                    </StackPanel>
                </Border>
                <DockPanel>
                    <!-- Einstellungen als Menü, damit die Seitenleiste ruhig bleibt. -->
                    <Button x:Name="SettingsButton" DockPanel.Dock="Right" Click="OnSettingsClick" Padding="8,6" Margin="6,0,0,0"
                            ToolTip="Einstellungen" AutomationProperties.Name="Einstellungen">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" FontSize="14" />
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="ShowHiddenBox" Header="Ausgeblendete anzeigen" IsCheckable="True"
                                          Checked="OnShowHiddenChanged" Unchecked="OnShowHiddenChanged" />
                                <MenuItem x:Name="AutostartBox" Header="Mit Windows starten" IsCheckable="True"
                                          Checked="OnAutostartChanged" Unchecked="OnAutostartChanged"
                                          ToolTip="Startet bei der Windows-Anmeldung im Infobereich" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="RescanButton" DockPanel.Dock="Right" Click="OnRescanClick" Padding="8,6"
                            ToolTip="Installierte Spiele neu suchen" AutomationProperties.Name="Spiele neu suchen">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="14" />
                    </Button>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" />
                </DockPanel>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <RadioButton x:Name="HomeNav" Style="{StaticResource NavItem}" GroupName="Nav" Tag="all" IsChecked="True" Checked="OnNavChecked">
                        <DockPanel>
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE80F;" />
                            <TextBlock x:Name="CountAll" Style="{StaticResource NavCount}" />
                            <TextBlock Text="Startseite" />
                        </DockPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="favorites" Checked="OnNavChecked">
                        <DockPanel>
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE734;" />
                            <TextBlock x:Name="CountFavorites" Style="{StaticResource NavCount}" />
                            <TextBlock Text="Favoriten" />
                        </DockPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="recent" Checked="OnNavChecked">
                        <DockPanel>
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE81C;" />
                            <TextBlock x:Name="CountRecent" Style="{StaticResource NavCount}" />
                            <TextBlock Text="Zuletzt gestartet" />
                        </DockPanel>
                    </RadioButton>
                    <Border Height="1" Margin="8,10" Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="games" Checked="OnNavChecked">
                        <DockPanel>
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE7FC;" />
                            <TextBlock x:Name="CountGames" Style="{StaticResource NavCount}" />
                            <TextBlock Text="Spiele" />
                        </DockPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="apps" Checked="OnNavChecked">
                        <DockPanel>
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE71D;" />
                            <TextBlock x:Name="CountApps" Style="{StaticResource NavCount}" />
                            <TextBlock Text="Programme" />
                        </DockPanel>
                    </RadioButton>

                    <!-- Eigene Kategorien; entstehen über das Kontextmenü einer Kachel. -->
                    <TextBlock x:Name="CategoryHeader" Text="Kategorien" FontSize="12" FontWeight="SemiBold" Margin="14,18,0,6"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                    <StackPanel x:Name="CategoryNav" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- Inhalt -->
        <Border Grid.Column="1" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Farbschein der Startseite: das Bannerbild winzig dekodiert und groß gezogen, das wirkt wie ein
                     starker Weichzeichner ohne Grafikeffekt (siehe UpdateHero). -->
                <Grid Grid.RowSpan="2" ClipToBounds="True" IsHitTestVisible="False" Height="700" VerticalAlignment="Top"
                      Visibility="{Binding Visibility, ElementName=Hero}">
                    <!-- Absolute Koordinaten: das Bild ragt über den Rand hinaus und würde den Verlauf sonst strecken. -->
                    <Grid.OpacityMask>
                        <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="0,700">
                            <GradientStop Color="#FF000000" Offset="0" />
                            <GradientStop Color="#8C000000" Offset="0.5" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Grid.OpacityMask>
                    <Image x:Name="Ambient" Stretch="Fill" Margin="-80" Opacity="0.55" RenderOptions.BitmapScalingMode="Linear" />
                </Grid>

                <DockPanel Margin="40,30,40,10">
                    <Button DockPanel.Dock="Right" Style="{DynamicResource AccentButtonStyle}" Click="OnAddClick"
                            Margin="12,0,0,0" Padding="14,7" VerticalAlignment="Center"
                            ToolTip="Programm oder Verknüpfung hinzufügen – Dateien lassen sich auch ins Fenster ziehen">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" Margin="0,0,8,0" />
                            <TextBlock Text="Hinzufügen" />
                        </StackPanel>
                    </Button>
                    <Grid DockPanel.Dock="Right" Width="300" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown"
                                 Padding="36,7,10,7" VerticalContentAlignment="Center" />
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" Margin="13,0,0,0" FontSize="14"
                                   IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Suchen – Enter startet" IsHitTestVisible="False" Margin="37,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock x:Name="PageSubtitle" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="40,10,22,24">
                    <StackPanel>
                    <!-- Banner der Startseite: zuletzt gestartet, sonst Favorit, sonst ein Spiel des Tages. -->
                    <Grid x:Name="Hero" Height="340" Margin="0,4,18,34" Visibility="Collapsed" SizeChanged="OnHeroSizeChanged">
                        <Grid.Clip>
                            <RectangleGeometry x:Name="HeroClip" RadiusX="16" RadiusY="16" />
                        </Grid.Clip>
                        <Grid>
                            <Rectangle Fill="#FF18181C" />
                            <Image Source="{Binding IconWash}" Stretch="Fill" Margin="-60" Opacity="0.6"
                                   RenderOptions.BitmapScalingMode="Linear" />
                            <Image x:Name="HeroImage" Stretch="UniformToFill" VerticalAlignment="Center" />
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#E6000000" Offset="0" />
                                        <GradientStop Color="#80000000" Offset="0.45" />
                                        <GradientStop Color="#00000000" Offset="0.8" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0.4" />
                                        <GradientStop Color="#A0000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <!-- Feiner Rand, damit sich das Banner auch vom Farbschein dahinter abhebt. -->
                            <Border CornerRadius="16" BorderThickness="1" BorderBrush="#26FFFFFF" />
                            <StackPanel VerticalAlignment="Bottom" Margin="40,0,40,34" TextElement.Foreground="White">
                                <Border HorizontalAlignment="Left" CornerRadius="11" Padding="11,4" Margin="0,0,0,14"
                                        Background="#33FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
                                    <TextBlock x:Name="HeroLabel" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                                <!-- Ohne Schatteneffekte: der dunkle Verlauf links hält Schrift und Logo lesbar. -->
                                <Image x:Name="HeroLogo" MaxHeight="96" MaxWidth="340" HorizontalAlignment="Left" Stretch="Uniform" />
                                <StackPanel x:Name="HeroTitle" Orientation="Horizontal">
                                    <Image Source="{Binding Icon}" Width="60" Height="60" Margin="0,0,18,0" />
                                    <TextBlock Text="{Binding DisplayName}" FontSize="40" FontWeight="Bold" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxWidth="600" />
                                </StackPanel>
                                <TextBlock Text="{Binding Subtitle}" Opacity="0.75" Margin="0,10,0,20" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{DynamicResource AccentButtonStyle}" Padding="28,11" FontSize="15" Click="OnHeroPlayClick">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" Margin="0,0,10,0" />
                                            <TextBlock x:Name="HeroPlayText" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="HeroFavoriteButton" Style="{StaticResource GlassButton}" Margin="10,0,0,0"
                                            Click="OnHeroFavoriteClick">
                                        <TextBlock x:Name="HeroFavoriteGlyph" Style="{StaticResource Glyph}" FontSize="16" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <ItemsControl x:Name="Sections" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,18">
                                    <StackPanel x:Name="Header" Orientation="Horizontal" Margin="0,6,0,16">
                                        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Border CornerRadius="10" Padding="8,1" Margin="10,2,0,0" VerticalAlignment="Center"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <TextBlock Text="{Binding Items.Count}" FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TileTemplate}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Title}" Value="">
                                        <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="0,0,0,60" Visibility="Collapsed">
                    <Grid Width="104" Height="104" HorizontalAlignment="Center">
                        <Ellipse Fill="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.14" />
                        <Ellipse Margin="14" Fill="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.14" />
                        <TextBlock x:Name="EmptyGlyph" Style="{StaticResource Glyph}" FontSize="36" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </Grid>
                    <TextBlock x:Name="EmptyTitle" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,22,0,6" />
                    <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="400"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <!-- Nur bei einer wirklich leeren Bibliothek: direkt loslegen. -->
                    <StackPanel x:Name="EmptyActions" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                        <Button Style="{DynamicResource AccentButtonStyle}" Padding="18,9" Click="OnAddClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" Margin="0,0,8,0" />
                                <TextBlock Text="Programm hinzufügen" />
                            </StackPanel>
                        </Button>
                        <Button Padding="18,9" Margin="10,0,0,0" Click="OnRescanClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" Margin="0,0,8,0" />
                                <TextBlock Text="Spiele suchen" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Tastenhilfe, sobald ein Controller angeschlossen ist. -->
                <Border x:Name="PadHints" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
                        CornerRadius="18" Padding="18,8" Background="#E6202020" Visibility="Collapsed" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.4" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" TextElement.Foreground="White" TextElement.FontSize="12">
                        <TextBlock Text="A" FontWeight="Bold" Foreground="#6CCB5F" Margin="0,0,6,0" />
                        <TextBlock Text="Starten" Margin="0,0,18,0" />
                        <TextBlock Text="B" FontWeight="Bold" Foreground="#FF6B6B" Margin="0,0,6,0" />
                        <TextBlock Text="Zurück" Margin="0,0,18,0" />
                        <TextBlock Text="X" FontWeight="Bold" Foreground="#4CC2FF" Margin="0,0,6,0" />
                        <TextBlock Text="Menü" Margin="0,0,18,0" />
                        <TextBlock Text="Y" FontWeight="Bold" Foreground="#FFC83D" Margin="0,0,6,0" />
                        <TextBlock Text="Favorit" Margin="0,0,18,0" />
                        <TextBlock Text="LB / RB" FontWeight="Bold" Margin="0,0,6,0" />
                        <TextBlock Text="Bereich wechseln" />
                    </StackPanel>
                </Border>

                <Grid x:Name="DropOverlay" Grid.RowSpan="2" IsHitTestVisible="False" Visibility="Collapsed"
                      Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                    <Rectangle Margin="20" RadiusX="12" RadiusY="12" StrokeThickness="2" StrokeDashArray="6 4"
                               Stroke="{DynamicResource AccentFillColorDefaultBrush}" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="40" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Zum Hinzufügen loslassen" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,4"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Programme, Verknüpfungen und Internetverknüpfungen" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
